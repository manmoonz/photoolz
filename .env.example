# Anthropic API key — required for 'photoolz album propose'
ANTHROPIC_API_KEY=your-api-key-here

# Optional: HuggingFace token — used by open_clip to download CLIP model weights
# on first run. Without this you may see an "unauthenticated requests" warning.
# The download works fine without it; the token only raises your rate limit.
# Obtain one at https://huggingface.co/settings/tokens
# HF_TOKEN=your-hf-token-here

# Optional: override default data directory (~/.photoolz/)
# PHOTOOLZ_DATA_DIR=/path/to/data/dir

# Optional: CLIP model (default: ViT-B-32)
# PHOTOOLZ_CLIP_MODEL=ViT-B-32

# Optional: compute device (default: auto-detect cuda if available, else cpu)
# PHOTOOLZ_DEVICE=cpu
